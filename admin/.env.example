# Copy to admin/.env — or just run ./admin/serve.sh, which writes it for you.
# Never commit the real file. It is gitignored.

# Every backoffice route lives under this. Generate a fresh one:
#   python3 -c "import secrets; print('/b-' + secrets.token_hex(8))"
CONTEXT_ADMIN_PREFIX=/b-CHANGE-ME

# The password. Long. This is what actually protects the backoffice —
# the prefix above only keeps it out of logs and crawlers.
CONTEXT_ADMIN_PASSWORD=

# From https://platform.claude.com/settings/keys — needs API credit,
# which is billed separately from a Claude Pro or Max subscription.
# Server-side only; never reaches a browser.
ANTHROPIC_API_KEY=

# Set to 1 ONLY for local http:// testing. Never on a real host.
CONTEXT_ADMIN_INSECURE_COOKIE=1
